{
  "name": "magical-game-night-gatherings",
  "private": true,
  "type": "module",
  "scripts": {
    "playtest": "node experiments/tabletop/app.mjs",
    "playtest:review": "node experiments/tabletop/review-server.mjs",
    "playtest:rules": "node experiments/tabletop/sync-rules.mjs",
    "playtest:headless": "node experiments/tabletop/app.mjs --headless",
    "playtest:serve": "node experiments/tabletop/server.mjs",
    "playtest:mcp": "node experiments/tabletop/mcp.mjs",
    "playtest:demo": "node experiments/tabletop/demo.mjs",
    "playtest:test": "node --test experiments/tabletop/*.test.mjs",
    "dev": "vitepress --host 127.0.0.1",
    "research:render": "node scripts/render-everyday-research.mjs",
    "build": "vitepress build",
    "build:github": "node scripts/build-github-pages.mjs",
    "copy:docs": "node scripts/copy-dist-to-docs.mjs",
    "publish": "npm run build && npm run copy:docs",
    "publish:github": "npm run build:github && npm run copy:docs",
    "preview": "vitepress preview --host 127.0.0.1",
    "serve:static": "python -m http.server 5174 --directory .vitepress/dist",
    "serve:docs": "python -m http.server 5175 --directory docs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.0.1",
    "@openai/codex": "0.163.0",
    "scryfall-mcp-server": "0.1.1",
    "vitepress": "^1.6.4"
  }
}
